// Hilbert curve
// rules from Paul Bourke's L-system notes:
// paulbourke.net/fractals/lsys
// X -> -YF+XFX+FY-
// Y -> +XF-YFY-FX+
angle = 90
step = 12

// + is turn(1), - is turn(-1)
function turn(k) { rotate k*angle deg }
function F() { forward step }

function X(n) {
  if n > 0 {
    turn(-1); Y(n-1); F(); turn(1)
    X(n-1); F(); X(n-1)
    turn(1); F(); Y(n-1); turn(-1)
  }
}

function Y(n) {
  if n > 0 {
    turn(1); X(n-1); F(); turn(-1)
    Y(n-1); F(); Y(n-1)
    turn(-1); F(); X(n-1); turn(1)
  }
}

X(5)
