// Peano curve
// X -> XFYFX+F+YFXFY-F-XFYFX
// Y -> YFXFY-F-XFYFX+F+YFXFY
angle = 90
step = 16

// + is turn(1), - is turn(-1)
function turn(k) { rotate k*angle deg }
function F() { forward step }

function X(n) {
  if n > 0 {
    X(n-1); F(); Y(n-1); F(); X(n-1)
    turn(1); F(); turn(1)
    Y(n-1); F(); X(n-1); F(); Y(n-1)
    turn(-1); F(); turn(-1)
    X(n-1); F(); Y(n-1); F(); X(n-1)
  }
}

function Y(n) {
  if n > 0 {
    Y(n-1); F(); X(n-1); F(); Y(n-1)
    turn(-1); F(); turn(-1)
    X(n-1); F(); Y(n-1); F(); X(n-1)
    turn(1); F(); turn(1)
    Y(n-1); F(); X(n-1); F(); Y(n-1)
  }
}

X(3)
