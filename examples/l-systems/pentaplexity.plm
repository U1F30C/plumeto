// Pentaplexity
// rules from Paul Bourke's L-system notes:
// paulbourke.net/fractals/lsys
// axiom F++F++F++F++F
// F -> F++F++F|F-F++F   (| turns around)
angle = 36

// + is turn(1), ++ is turn(2)
function turn(k) { rotate k*angle deg }

function F(n) {
  if n == 0 { forward 4 } else {
    F(n-1); turn(2); F(n-1); turn(2); F(n-1)
    rotate 180 deg; F(n-1); turn(-1); F(n-1)
    turn(2); F(n-1)
  }
}

for i in 1..5 { F(4); turn(2) }
