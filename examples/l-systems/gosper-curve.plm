// Gosper curve
// A -> A-B--B+A++AA+B-
// B -> +A-BB--B-A++A+B
angle = 60

// + is turn(1), -- is turn(-2)
function turn(k) { rotate k*angle deg }

function A(n) {
  if n == 0 { forward 6 } else {
    A(n-1); turn(-1); B(n-1); turn(-2); B(n-1)
    turn(1); A(n-1); turn(2); A(n-1); A(n-1)
    turn(1); B(n-1); turn(-1)
  }
}

function B(n) {
  if n == 0 { forward 6 } else {
    turn(1); A(n-1); turn(-1); B(n-1); B(n-1)
    turn(-2); B(n-1); turn(-1); A(n-1); turn(2)
    A(n-1); turn(1); B(n-1)
  }
}

A(4)
