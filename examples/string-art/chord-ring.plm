// a ring of chords: every point of a circle is joined to the one k steps along, and the
// lines leave a round hole whose edge is the envelope of the chords
pi = acos(-1)
n = 90
k = 33
radius = 220

function line(x1, y1, x2, y2) {
  heading = atan2(y2 - y1, x2 - x1)
  place x1, y1
  rotate heading rad
  forward hypot(x2 - x1, y2 - y1)
  rotate -heading rad
}

for i in 0..n - 1 {
  a = 2 * pi * i / n
  b = 2 * pi * (i + k) / n
  line(radius * cos(a), radius * sin(a), radius * cos(b), radius * sin(b))
}
