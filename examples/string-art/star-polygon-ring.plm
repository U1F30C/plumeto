// a star polygon with many points and a round hole in the middle: 29 points, each joined to
// the one 13 steps along
pi = acos(-1)
n = 29
k = 13
radius = 220

function line(x1, y1, x2, y2) {
  heading = atan2(y2 - y1, x2 - x1)
  place x1, y1
  rotate heading rad
  forward hypot(x2 - x1, y2 - y1)
  rotate -heading rad
}

for i in 0..n - 1 {
  a = 2 * pi * i / n - pi / 2
  b = 2 * pi * (i + k) / n - pi / 2
  line(radius * cos(a), radius * sin(a), radius * cos(b), radius * sin(b))
}
