// pointed stars: each is three spirograph curves with the pen at different distances from
// the wheel's middle, nested one inside the other
pi = acos(-1)
size = 150
gap = 340

function line(x1, y1, x2, y2) {
  heading = atan2(y2 - y1, x2 - x1)
  place x1, y1
  rotate heading rad
  forward hypot(x2 - x1, y2 - y1)
  rotate -heading rad
}

// ring radius, wheel radius, how far the pen is from the wheel's middle, and how many
// times around the ring the wheel must go for the curve to close
function spiro(cx, cy, ring, wheel, pen, turns) {
  scale = size / (ring - wheel + pen)
  steps = 70 * turns
  for i in 1..steps {
    t0 = 2 * pi * turns * (i - 1) / steps
    t1 = 2 * pi * turns * i / steps
    line(
      cx + scale * ((ring - wheel) * cos(t0) + pen * cos((ring - wheel) / wheel * t0)),
      cy + scale * ((ring - wheel) * sin(t0) - pen * sin((ring - wheel) / wheel * t0)),
      cx + scale * ((ring - wheel) * cos(t1) + pen * cos((ring - wheel) / wheel * t1)),
      cy + scale * ((ring - wheel) * sin(t1) - pen * sin((ring - wheel) / wheel * t1))
    )
  }
}

color lightsalmon
spiro(0, 0, 4, 1, 0.95, 1)
color khaki
spiro(0, 0, 4, 1, 0.7, 1)
color powderblue
spiro(0, 0, 4, 1, 0.45, 1)

color plum
spiro(gap, 0, 8, 3, 3.2, 3)
color lightpink
spiro(gap, 0, 8, 3, 2.5, 3)
color lightskyblue
spiro(gap, 0, 8, 3, 1.8, 3)

color palegreen
spiro(0, gap, 6, 1, 1, 1)
color khaki
spiro(0, gap, 6, 1, 0.75, 1)
color lightsalmon
spiro(0, gap, 6, 1, 0.5, 1)

color lavender
spiro(gap, gap, 5, 2, 2.2, 2)
color pink
spiro(gap, gap, 5, 2, 1.7, 2)
color mediumaquamarine
spiro(gap, gap, 5, 2, 1.2, 2)
