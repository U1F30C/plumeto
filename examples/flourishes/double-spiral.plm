// two spirals joined by an S: the curve turns hard to one side at the start, less and less,
// then the other way more and more. The turn per step goes from +10 to -10 degrees.
function bend(steps, length, a0, a1) {
  for i in 0..steps - 1 {
    forward length
    rotate a0 + (a1 - a0) * i / (steps - 1) deg
  }
}

rotate 260 deg
bend(200, 2.6, 10, -10)
